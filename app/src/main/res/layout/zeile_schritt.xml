<?xml version="1.0" encoding="utf-8"?>
<!--
  Ein Schritt der Einrichtung. Das Zeichen links sagt den Zustand, und es
  sagt ihn als Zeichen und nicht als Farbe - wer Farben schlecht
  unterscheidet, muss Haken, Kreis und Fragezeichen trotzdem auseinander
  halten koennen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/schritt_zeichen"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:textSize="21sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/schritt_titel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grau_dunkel"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/schritt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/grau"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/schritt_knopf"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
