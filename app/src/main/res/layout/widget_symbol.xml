<?xml version="1.0" encoding="utf-8"?>
<!--
  Das quadratische Widget: dieselbe Hoehe wie der breite Balken, aber nur
  eine Zelle breit. Gedacht fuer den Platz daneben - der Balken sagt, wer
  hilft, dieses hier sagt, wie das Programm heisst.

  Der Text steht unter der Grafik und nicht darin: "HANDYHelfer" ist elf
  Zeichen lang, und in einer Zelle Breite bleibt dafuer nur, wenn es die
  volle Breite bekommt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hintergrund"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/symbol_bild"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/handys" />

    <TextView
        android:id="@+id/symbol_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/weiss"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
