<?xml version="1.0" encoding="utf-8"?>
<!--
  Kraeftiges Blau mit weissem Rand - dieselbe Bauart wie beim Widget von
  DialOS Mobil. Der Rand ist keine Zierde: Ein randloser blauer Balken
  verschwindet auf einem hellen Hintergrundbild, und das Widget soll auf
  jedem auffallen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/blau" />
    <corners android:radius="24dp" />
    <stroke
        android:width="2dp"
        android:color="@color/weiss" />
</shape>
