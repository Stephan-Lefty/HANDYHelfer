<?xml version="1.0" encoding="utf-8"?>
<!--
  Eine Zelle breit, eine hoch - dieselbe Hoehe wie der breite Balken
  (hilfe_widget_info.xml), damit beide nebeneinander auf einer Linie stehen.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="80dp"
    android:minHeight="80dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:description="@string/symbol_widget_beschreibung"
    android:initialLayout="@layout/widget_symbol"
    android:previewLayout="@layout/widget_symbol"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
