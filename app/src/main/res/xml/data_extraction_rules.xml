<?xml version="1.0" encoding="utf-8"?>
<!--
  Nichts wird gesichert und nichts wandert auf ein neues Geraet.

  Das ist Absicht und nicht Sparsamkeit: Gesichert wuerden der hinterlegte
  Helfer und das Protokoll. Beides soll nicht stillschweigend auf einem
  anderen Telefon wieder auftauchen - wer das Geraet wechselt, richtet
  HANDYHelfer neu ein, und genau in diesem Moment bestaetigt jemand bewusst,
  wer helfen darf.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
